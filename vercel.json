{
  "rewrites": [
    {
      "source": "/e/:evid",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Twitterbot|Slackbot|Discordbot|WhatsApp|TelegramBot|LinkedInBot|Googlebot).*"
        }
      ],
      "destination": "/api/og?evid=:evid"
    },
    {
      "source": "/((?!api|terrain|cesium|assets).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/terrain/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/cesium/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
